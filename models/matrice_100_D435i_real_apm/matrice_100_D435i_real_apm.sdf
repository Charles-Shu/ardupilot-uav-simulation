<!-- ==================== Rotor 3 ==================== -->
    <link name="rotor_3">

      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>

      <pose>-0.22980970388562794 -0.22980970388562796 0.06 0 0 0</pose>
      <inertial>
          <mass>0.019</mass>
          <inertia>
            <ixx>6.349166666666668e-07</ixx>
            <iyy>4.310783333333334e-05</iyy>
            <izz>4.3739583333334e-05</izz>
          </inertia>
        </inertial>
      <visual name="rotor_3_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://matrice_100_D435i_real_apm/meshes/dji_13455_prop_cw.dae</uri>
