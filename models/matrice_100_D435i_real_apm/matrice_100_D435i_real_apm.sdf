    <joint name="rotor_3_joint" type="revolute">
      <parent>fuselage</parent>
      <child>rotor_3</child>
      <axis>
        <xyz>0 0 1</xyz>
	<limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <damping>0.004</damping>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
      <physics>
        <ode>
          <implicit_spring_damper>1</implicit_spring_damper>
        </ode>
      </physics>
    </joint>
<!-- ==================== Intel RealSense D435i Camera ==================== -->
    <include>
      <uri>model://D435i_real</uri>
      <pose>0.15 0 -0.02 1.57 0 1.57</pose>
    </include>

    <joint name="d435i_camera_joint" type="fixed">
      <parent>fuselage</parent>
      <child>D435i_real::camera_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <upper>0</upper>
          <lower>0</lower>
        </limit>
      </axis>
    </joint>

    <!-- ==================== GPS ==================== -->
    <include>
      <uri>model://gps</uri>
      <pose>0.1 0 0 0 0 0</pose>
      <name>gps0</name>
    </include>

    <joint name="gps0_joint" type="fixed">
      <parent>fuselage</parent>
      <child>gps0::link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <upper>0</upper>
          <lower>0</lower>
        </limit>
      </axis>
    </joint>

    <!-- ==================== Livox Mid-360 LiDAR (top-mounted, 360° scan) ==================== -->
    <include>
      <uri>model://Mid360_real</uri>
      <pose>0 0 0.08 0 0 0</pose>
    </include>

    <joint name="mid360_joint" type="fixed">
      <parent>fuselage</parent>
      <child>Mid360_real::livox_base</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <upper>0</upper>
          <lower>0</lower>
        </limit>
      </axis>
    </joint>

    <!-- ==================== PX4 Plugins ==================== -->




<!-- ============ APM: LiftDrag + ArduPilotPlugin ============ -->
    <plugin name="rotor_0_blade_1" filename="libLiftDragPlugin.so">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.7</cda>
      <cma>0.00</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>0 0.12 0</cp>
      <forward>-1 0 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_0</link_name>
    </plugin>
