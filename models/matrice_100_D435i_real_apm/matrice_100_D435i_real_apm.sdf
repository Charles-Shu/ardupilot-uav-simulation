        <pose>0 0 0 0 0 0 </pose>
        <geometry>
          <box>
            <size>0.33 0.02 0.001</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>

    </link>

    <joint name="rotor_2_joint" type="revolute">
      <parent>fuselage</parent>
      <child>rotor_2</child>
      <axis>
        <xyz>0 0 1</xyz>
	<limit>
